<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/obsidianBackground</item>
        <item name="android:windowBackground">@color/obsidianBackground</item>
        <item name="android:statusBarColor">@color/obsidianBackground</item>
        <item name="android:navigationBarColor">@color/obsidianBackground</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/obsidianBackground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/obsidianBackground</item>
        <item name="android:navigationBarColor">@color/obsidianBackground</item>
    </style>
</resources>
