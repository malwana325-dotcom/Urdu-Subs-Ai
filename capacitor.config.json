{
  "appId": "com.urdudubber.app",
  "appName": "Urdu Localizer",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#090a0d",
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "style": "DARK",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#090a0d"
    }
  }
}
